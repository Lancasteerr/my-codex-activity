{
  "name": "codex-activity",
  "version": "0.1.0",
  "description": "Publish Codex activity to your GitHub Profile without publishing credentials.",
  "type": "module",
  "engines": { "node": ">=24.10.0" },
  "license": "MIT",
  "bin": { "codex-activity": "src/cli.mjs" },
  "scripts": {
    "setup": "node src/cli.mjs setup",
    "status": "node src/cli.mjs status",
    "sync": "node src/cli.mjs sync",
    "test": "node --test tests/*.test.mjs",
    "render:example": "node scripts/example.mjs"
  },
  "files": ["src/", "scripts/release.mjs", "templates/", "examples/", ".env.example", "README.md", "LICENSE"],
  "repository": { "type": "git", "url": "https://github.com/Lancasteerr/codex-activity.git" }
}
